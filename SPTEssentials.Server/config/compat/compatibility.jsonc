{
  "rules": [
    // Container or case example:
    // {
    //   "TARGET-TPL": "PUT_TARGET_CONTAINER_TPL_HERE",
    //   "ALLOWED_TPLS": [
    //     "PUT_ALLOWED_ITEM_OR_CATEGORY_TPL_HERE"
    //   ],
    //   "GRID_INDEXES": null,
    //   "REPLACE": false
    // },

    // Special Slot example. GRID_INDEXES uses slot numbers 1 through 6:
    // {
    //   "TARGET-TPL": "@PMC_SPECIALSLOTS",
    //   "ALLOWED_TPLS": [
    //     "PUT_ALLOWED_ITEM_OR_CATEGORY_TPL_HERE"
    //   ],
    //   "GRID_INDEXES": [1, 2, 3, 4, 5, 6],
    //   "REPLACE": false
    // },

    // Weapon or attachment example with one slot group:
    // {
    //   "TARGET-TPL": "PUT_WEAPON_OR_ATTACHMENT_TPL_HERE",
    //   "ALLOWED_TPLS": [
    //     "PUT_ALLOWED_PART_TPL_HERE"
    //   ],
    //   "SLOT_NAMES": [
    //     "mod_scope"
    //   ],
    //   "REPLACE": false
    // },

    // Weapon or attachment example with several slot groups.
    // Use this when different parts belong in different slots on the same target:
    // {
    //   "TARGET-TPL": "PUT_WEAPON_OR_ATTACHMENT_TPL_HERE",
    //   "SLOT_RULES": [
    //     {
    //       "SLOT_NAMES": ["mod_stock"],
    //       "ALLOWED_TPLS": [
    //         "PUT_ALLOWED_STOCK_TPL_HERE"
    //       ]
    //     },
    //     {
    //       "SLOT_NAMES": ["mod_gas_block"],
    //       "ALLOWED_TPLS": [
    //         "PUT_ALLOWED_GAS_BLOCK_TPL_HERE"
    //       ]
    //     }
    //   ],
    //   "REPLACE": false
    // }
  ]
}
